CGSensorView::CGSensorView()
	:m_oGValue(NULL)
{
	int i;
	m_bRedrawBlocked = FALSE;
	m_nLBtnFlag = 0;
	m_nMouseOnFlag = 0;
	m_SeekMessageID = 0;
	m_nDrawIndex = 0;
	m_nLastIndexPoint = 0;
	m_nLastRefreshPoint = 0;
	m_nLastIndex = 0;
	m_nYDecimals = 0 ;
	m_nXDecimals = 0 ;
	m_nGDecimals = 2 ;
	m_dScaleX = 1;
    m_dLowerLimit = 0 ;
	m_dUpperLimit =  100 ;
	m_nMaxShowIndexCnt = 100;
	m_dGridInterval = 0;
	m_dRange      =  m_dUpperLimit - m_dLowerLimit ;   // protected member variable

	m_dXLower = 0 ;
