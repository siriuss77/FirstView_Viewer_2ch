double CGPSData::FromDegree(double dbValue)
{
	double d = (int)dbValue;
	double m = ((dbValue - d) * 100.0);

	return d + m / 60.0;
}


double CGPSData::GetLat(void)
{
	if(m_bNotDegree)
		return m_fLat;
	
	return FromDegree(m_fLat * 0.01);
}

double CGPSData::GetLng(void)
{
	if(m_bNotDegree)
		return m_fLng;
	
	return FromDegree(m_fLng * 0.01); 
}
