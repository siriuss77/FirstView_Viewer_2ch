	if( !pCludePack->init() )
	{
		CLD_FL( DF_ERROR, "Can not load CLUDE.PACK" );
		goto LOADING_FAILED;
	}

	if( !this->m_AppGlobalSetting.loadCludePack(pCludePack) )
	{
		CLD_FL( DF_ERROR, "Can not load application's information in CLUDE.PACK" );
		goto LOADING_FAILED;
