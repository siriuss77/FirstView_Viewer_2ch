CGPoint::CGPoint()
{
}
CGPoint::CGPoint(int px, int pxy, int pyy, int pzy, int psy, int event)
{
	x = px;
	xy = pxy;
	yy = pyy;
	zy = pzy;
	sy = psy;
	evt = event;
}
CGPoint::CGPoint(const GPOINT& srcGPoint)
{
	x = srcGPoint.x;
	xy =  srcGPoint.xy;
	yy =  srcGPoint.yy;
	zy =  srcGPoint.zy;
	sy = srcGPoint.sy;
	evt = srcGPoint.evt;
}
CGPoint::CGPoint(LPGPOINT lpSrcGPoint)
{
	x = lpSrcGPoint->x;
	xy =  lpSrcGPoint->xy;
	yy =  lpSrcGPoint->yy;
	zy =  lpSrcGPoint->zy;
	sy = lpSrcGPoint->sy;
	evt = lpSrcGPoint->evt;
}
void CGPoint::SetGPoint(int px, int pxy, int pyy, int pzy, int psy, int event) 
{
	x = px;
	xy = pxy;
	yy = pyy;
	zy = pzy;
	sy = psy;
	evt = event;
}
void CGPoint::operator=(const GPOINT& srcGPoint)
{
	x = srcGPoint.x;
	xy =  srcGPoint.xy;
	yy =  srcGPoint.yy;
	zy =  srcGPoint.zy;
	sy =  srcGPoint.sy;
	evt = srcGPoint.evt;
}


