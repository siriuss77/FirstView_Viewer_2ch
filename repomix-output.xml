	}
	else
		return;

	if(pBtnZoom->GetCheckState() == FALSE){
		//this->m_multiPlayer.SetPosition(this->m_multiPlayer.GetCurrentPosition()); //20200729 zoom On/Off 프레임 이동 문제가 있어 삭제
	}
	else
		this->OnDrawZoomImage();
	
