		fileName.Append(_T("\\"));
		fileName.Append(BLACKBOX_CONFIG_FILE_NAME);
	}
	else
	{
		fileName.Append(_T("\\"));
		fileName.Append(BLACKBOX_CONFIG_FILE);
	}
	
