		CfgPrintfToFile(fhandle, "Channel            = %d ; 	%d:1CH             ", spConfig->stRecord.eChannel, i++);
#else
		CfgPrintfToFile(fhandle, "Channel            = %d ; 	%d:1CH(FRONT) ", spConfig->stRecord.eChannel, i++);
#endif
#if CONFIG_MAX_CAMERA >= 2
