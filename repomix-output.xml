 #if (BUILD_MODEL != MODEL_BW_2000 && BUILD_MODEL != MODEL_KIC_M7 && BUILD_MODEL != MODEL_ICARO_I300HD && BUILD_MODEL != MODEL_DOOCO_M7 && BUILD_MODEL != MODEL_EYE_TRACKS)		
