	RDF_TYPE_BBOX,
	RDF_TYPE_GPS,
	RDF_TYPE_PULSE,
	RDF_TYPE_GSENSOR,

	RDF_TYPE_END
}E_RDF_TYPE;

typedef packed struct	// 20 Byte
{
	char 		header[RDF_HEADER_STRING_SIZE]; 	//헤더 (고정 문자열 (ASCII)) 
	u32			utd_time;	//기록 시작 시간 (UTC) 
