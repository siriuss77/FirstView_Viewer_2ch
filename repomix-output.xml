<?xml version="1.0" encoding="utf-8"?>
<dialog>
  <property>
  	<title>2HD Blackbox Viewer</title>
  	<geometry x="-1" y="-1" w="1024" h="728"/>
    <bgimgs>
      <bgimg mode="0">
        <image>./main/bg_NewSpaceDesign.bmp</image>
      </bgimg>
      <bgimg mode="1">
        <image drawmode="buttonface" x="0" y="0" w="full" h="50">./main/full_bg_top.bmp</image>
        <image drawmode="buttonface" geobase="left|bottom" x="0" y="50" w="full" h="50">./main/full_bg_bottom.bmp</image>
      </bgimg>
    </bgimgs>
    <!-- Follwing items are user interface mode-->
    <!-- 0 : Normal screen Mode -->
    <!-- 1 : Fullscreen Mode -->
  </property>
  <controls>
   <control type="video" id="main.video.zoom">
      <mode x="5" y="55" w="720" h="405">0</mode>
      <mode geobase="wratio" w="100" h="50">1</mode>
    </control>
