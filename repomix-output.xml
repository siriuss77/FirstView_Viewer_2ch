	m_nGValueFontSize = 14;
	
	m_fontGValue.CreateFont (m_nGValueFontSize, 0, 0, 0, 300,
                       FALSE, FALSE, 0, ANSI_CHARSET,
                       OUT_DEFAULT_PRECIS, 
                       CLIP_DEFAULT_PRECIS,
                       DEFAULT_QUALITY, 
                       DEFAULT_PITCH|FF_SWISS, _T("Arial")) ;
	 
	m_fontAxisX.CreateFont (m_nAxisXFontSixe, 0, 0, 0, 300,
