    this->m_NXFSDirInfo[1].m_nCapPercent = NXFS_DIR_CAP_PERCENT_1;
    this->m_NXFSDirInfo[2].m_nCapPercent = NXFS_DIR_CAP_PERCENT_2;
    this->m_NXFSDirInfo[3].m_nCapPercent = NXFS_DIR_CAP_PERCENT_3;
