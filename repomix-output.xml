		//this->InvalidateRect( NULL );
	}
#ifdef TIME_SEARCH_USE
	ShowWindowTimeSearch(SW_SHOW);
#endif	

//// ++{ 20201026 FVFS Added *******************
	if(m_cstrFvfsFileToAvi.GetLength()){
		//if(!CBBoxUtil::ReplaceFileData(m_cstrFvfsFileToAvi, "FVFS   CDR MOVIE", 16, 0)){
		//}
