ClCludeDialog::ClCludeDialog()
{
	this->m_pDialogManager	= NULL;
	this->m_pControlFactory	= NULL;
}


ClCludeDialog::~ClCludeDialog()
{
	if( this->m_pControlFactory )	delete this->m_pControlFactory;
}

