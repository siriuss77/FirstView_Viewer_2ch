	dlg.DoModal();

	//CWBCConfigure::releaseInstance();

LOADING_FAILED:

#if defined(_DEBUG)
	printf("\n PRESS ANY KEY TO CLOSE DEBUG WINDOW.");
	_getch();
#endif

	return FALSE;
