bool CWBCIniLoader::getItemValue( const std::string& stsItemName, float* pValue )
{
    int nIndex;
    if( ! this->isExistItem(stsItemName, &nIndex) )
        return false;

    ITER_INIITEM iIni = this->m_IniList.begin();
    std::advance( iIni, nIndex );

