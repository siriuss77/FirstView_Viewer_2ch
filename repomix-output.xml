	{
		//INT nWidth = this->GetColumnInfo( nCounter );
		//this->InsertColumn( nCounter, TEXT("ITEM"), LVCFMT_LEFT, nWidth );

		LVCOLUMN COL;
		COL.mask	=LVCF_FMT | LVCF_WIDTH | LVCF_TEXT |LVCF_SUBITEM;
