{
	this->m_gseonsorX   = newData.m_gseonsorX;
	this->m_gseonsorY   = newData.m_gseonsorY;
	this->m_gseonsorZ   = newData.m_gseonsorZ;
	this->m_cts         = newData.m_cts;
}

