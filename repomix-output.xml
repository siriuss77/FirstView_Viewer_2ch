	ScreenToClient(&rcClient);

	CString str;

if(m_pCLanguage){
	 	CString strText;
		
#if (BUILD_MODEL == MODEL_DAVIEW_2CH_L)                       // jun 170405

           if(m_pCLanguage->GetLenguageText(&strText,CLanguage::TEXT_REPORT))
		
