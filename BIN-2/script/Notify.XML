    <control type="text" id="notify.text.title">
      <mode x="10" y="5" w="390" h="25">0</mode>
      <mode x="10" y="5" w="390" h="25">1</mode>
      <text color="255|255|155|0" format="left|vcenter|bold" size="10"></text>
    </control>
    <control type="text" id="notify.text.comment">
      <mode x="30" y="30" w="350" h="70">0</mode>
      <mode x="30" y="30" w="350" h="70">1</mode>
      <text color="255|255|255" format="left|vcenter|bold|wordbreak" size="10"></text>
    </control>
  </controls>
</dialog>
