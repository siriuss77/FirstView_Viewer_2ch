<?xml version="1.0" encoding="utf-8"?>
<dialog>
  <property>
  	<geometry x="-1" y="-1" w="400" h="150"/>
    <bgimgs>
      <bgimg mode="0">
        <image drawmode="buttonface">./popup/popup_bg.bmp</image>
      </bgimg>
      <bgimg mode="1">
        <image drawmode="buttonface">./popup/popup_bg.bmp</image>
      </bgimg>
    </bgimgs>
  </property>
  <!-- mode 0 : normal notify dialog has OK button only.-->
  <!-- mode 1 : selection notify dialog has OK and Cancel button.-->
  <controls>
    <control type="button" id="notify.button.ok_eng">
      <mode geobase="center|bottom" x="-52" y="45" w="104" h="24">0</mode>
      <skins>
        <skin type="normal" drawmode="stretch" tpcolor="255|0|255" sx="0" sy="0" sw="104" sh="24">./popup/accept_eng.bmp</skin>
        <skin type="pushed" drawmode="stretch" tpcolor="255|0|255" sx="104" sy="0" sw="104" sh="24">./popup/accept_eng.bmp</skin>
        <skin type="disabled" drawmode="stretch" tpcolor="255|0|255" color="96|255|255|255" sx="0" sy="0" sw="104" sh="24">./popup/accept_eng.bmp</skin>
        <skin type="hover" drawmode="stretch" tpcolor="255|0|255" sx="0" sy="0" sw="104" sh="24">./popup/accept_eng.bmp</skin>
      </skins>
    </control>
    <control type="button" id="notify.button.ok_kor">
