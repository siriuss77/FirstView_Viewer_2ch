<?xml version="1.0" encoding="utf-8"?>
<dialog>
  <property>
  	<geometry x="-1" y="-1" w="400" h="150"/>
    <bgimgs>
      <bgimg mode="0">
        <image drawmode="buttonface">./popup/popup_bg.bmp</image>
      </bgimg>
    </bgimgs>
  </property>
  <controls>
    <control type="button" id="seldrive.button.ok">
      <mode geobase="center" x="-155" y="114" w="154" h="31">0</mode>
      <skins>
        <skin type="normal" tpcolor="255|0|255">./popup/accept_nor.bmp</skin>
        <skin type="pushed" tpcolor="255|0|255">./popup/accept_press.bmp</skin>
        <skin type="disabled" tpcolor="255|0|255" color="96|255|255|255">./popup/accept_nor.bmp</skin>
        <skin type="hover" tpcolor="255|0|255">./popup/accept_over.bmp</skin>
      </skins>
    </control>
    <control type="button" id="seldrive.button.cancel">
      <mode geobase="center" x="1" y="114" w="154" h="31">0</mode>
      <skins>
        <skin type="normal" tpcolor="255|0|255">./popup/close_nor.bmp</skin>
        <skin type="pushed" tpcolor="255|0|255">./popup/close_press.bmp</skin>
        <skin type="disabled" tpcolor="255|0|255" color="96|255|255|255">./popup/close_nor.bmp</skin>
        <skin type="hover" tpcolor="255|0|255">./popup/close_over.bmp</skin>
      </skins>
    </control>
    <control type="text" id="seldrive.text.title">
      <mode x="10" y="0" w="390" h="25">0</mode>
      <text color="255|255|155|0" format="left|vcenter|bold" size="10">Select blackbox dedicated drive.</text>
    </control>
    <!--control type="image" id="image.title">
      <mode x="10" y="2" w="390" h="30">0</mode>
      <image>./images/popup/</image>
    </control-->
    <control type="text" id="seldrive.text.drive">
      <mode x="10" y="55" w="150" h="30">0</mode>
      <text color="160|255|255|255" format="left|vcenter|bold" size="10">Selected Drive : </text>
    </control>
  </controls>
</dialog>
